msgid "Power Off"
msgstr "关机"

msgid "⚠️ Power Off Device"
msgstr "⚠️ 设备关机"

msgid "Perform Power Off"
msgstr "执行关机"

msgid "Turn off the power to the device you are using"
msgstr "关闭当前使用的设备电源"

msgid "This action will immediately turn off the power to your device. Make sure to save all your work before proceeding."
msgstr "此操作将立即切断设备电源，请在继续前保存所有未保存的工作"

msgid "Powering off device..."
msgstr "正在关机..."

msgid "Confirm Power Off"
msgstr "确认关机"

msgid "Cancel"
msgstr "取消"

msgid "Warning!"
msgstr "警告！"

msgid "Warning: There are unsaved changes that will be lost when the device powers off!"
msgstr "警告：存在未保存的修改，设备关机后将丢失！"

msgid "Error!"
msgstr "错误！"

msgid "Before you continue:"
msgstr "继续关机之前："

msgid "Save all unsaved settings"
msgstr "保存所有未保存的设置"

msgid "Check if other users are active"
msgstr "检查是否有其他在线用户"

msgid "The device needs to be manually turned on"
msgstr "设备需要手动开启"

msgid "Powering Off"
msgstr "关机中"

msgid "The device should power off within a few seconds. If the device remains on, you may need to perform a manual shutdown."
msgstr "设备将在数秒内关机。若未正常关机，请尝试手动关闭电源"

msgid "Power off failed with code %s"
msgstr "关机失败，退出码 %s"
